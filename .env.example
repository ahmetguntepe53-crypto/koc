# Tarayıcı ve iOS Simulator için: Simulator, Mac'in ağını paylaştığı için localhost çalışır.
VITE_API_URL=http://localhost:4100/api

# GERÇEK iPhone'a kurarken localhost cihazın KENDİSİNİ gösterir — Mac'in LAN IP'sini yazın
# (ipconfig getifaddr en0) ve `npm run ios:sync` ile yeniden derleyin:
# VITE_API_URL=http://192.168.1.42:4100/api
#
# Not: VITE_API_URL derleme ANINDA gömülür — değiştirdikten sonra mutlaka yeniden build alın.
