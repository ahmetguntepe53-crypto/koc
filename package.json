{
  "name": "kocluk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sınav koçluğu takip sistemi — öğretmen/öğrenci ödev ve geri dönüt yönetimi",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
