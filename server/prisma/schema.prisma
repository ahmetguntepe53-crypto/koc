generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// LGS: 7-8. sınıf (ortaokul, liselere geçiş sınavı). TYT/AYT: 9-12. sınıf (lise, YKS'nin iki bileşeni).
// Hangi türün geçerli olduğu Assignment/StudySession oluşturulurken User.gradeLevel'dan türetilir
// (bkz. server/src/subjects.js > trackForGrade/trackForExamType) — burada ayrı bir "sınav grubu"
// alanı YOK, gradeLevel tek doğruluk kaynağı.
enum ExamType {
  TYT
  AYT
  LGS
}

// Bir ödevin tekrar sıklığı sınıflandırması — YALNIZCA bir ETİKETTİR. "Haftalık" seçilince sistem
// otomatik olarak her hafta yeni bir ödev ÜRETMEZ; koç her ödevi kendisi tek tek oluşturur.
enum Period {
  WEEKLY
  MONTHLY
  YEARLY
}

// Ödevin öğrenciye ne zaman görünür/bildirim gideceğini belirler:
// AUTO_ON_DATE    — scheduledDate geldiğinde scheduler.js otomatik gönderir.
// AUTO_DAY_BEFORE — scheduledDate'ten bir gün önce scheduler.js otomatik gönderir.
// MANUAL_NOW      — koç oluşturduğu anda (ya da sonradan "Şimdi Gönder" ile) elle gönderir.
enum SendMode {
  AUTO_ON_DATE
  AUTO_DAY_BEFORE
  MANUAL_NOW
}

enum AssignmentStatus {
  DRAFT // "Bekliyor" — henüz öğrenciye gönderilmedi, koç tarafından düzenlenebilir/silinebilir
  SENT // "Gönderildi" — öğrenciye bildirim gitti, artık düzenlenemez
}

// Ödev oluşturulduğu anda hedef kitle sabitlenir (AssignmentRecipient satırları o anda yaratılır) —
// bu alan yalnızca arayüzde "kime gönderildi" bilgisini göstermek içindir.
enum AssignmentTarget {
  WHOLE_GROUP
  SINGLE_STUDENT
  SELECTED_STUDENTS // koç, roster'daki (aynı sınav türündeki) öğrencilerden tik ile bir alt küme seçti
  SCHOOL_WIDE // bkz. User.isSubjectTeacher — kendi koçluk ettiği öğrencilerle sınırlı değil, okuldaki TÜM ilgili track'e gönderildi
}

model User {
  id    String  @id @default(cuid())
  // Giriş kimliği e-posta YA DA kullanıcı adı (username) olabilir — ikisi de tekil, en az biri dolu
  // (bkz. routes/admin.js > createOneUser). Okuldaki öğrencilerin çoğunun e-postası yok: okul
  // numarası kullanıcı adı olur. E-postası olmayan hesap "şifremi unuttum" kullanamaz, şifresini
  // admin belirler.
  email    String? @unique
  username String? @unique
  // İlk şifresi tahmin edilebilir olan hesaplar (okul numarası = şifre, ya da adminin belirlediği geçici
  // şifre) ilk girişte kendi şifresini belirlemeden uygulamayı kullanamaz — bkz. middleware/auth.js.
  mustChangePassword Boolean @default(false)
  // Hesap admin tarafından oluşturulduğunda bilerek null bırakılır — kullanıcı e-postasına gelen
  // "şifreni belirle" bağlantısıyla (resetToken) kendi şifresini kendisi koyar.
  passwordHash String?
  role         Role
  name         String
  phone        String?
  // Admin tarafından hesabın devre dışı bırakılması — true iken giriş tamamen reddedilir.
  banned Boolean @default(false)
  // Şifre değişince / hesap ban'lanıp tekrar açılınca artırılır — requireAuth tüm eski JWT'leri
  // (süresi dolmamış olsa bile) anında geçersiz kılar.
  tokenVersion Int @default(0)
  // Hem ilk şifre belirleme (admin hesap oluşturunca) hem "şifremi unuttum" için ortak kullanılır.
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  // İlk şifre belirleme sırasında (yalnızca o an, passwordHash henüz null iken) Gizlilik
  // Politikası/KVKK/Kullanım Şartları onayı zorunlu tutulur — bkz. routes/auth.js reset-password.
  // "Şifremi unuttum" akışında (passwordHash zaten var) tekrar sorulmaz.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // --- Yalnızca role=STUDENT için anlamlı ---
  // Yalnızca bilgi/raporlama amaçlı serbest metin (ör. "12/A") — ödev hedefleme bunun üzerinden
  // yapılmaz, ayrı bir Sınıf/roster tablosu bilinçli olarak yok.
  className String?
  // Öğrencinin gerçek sınıf düzeyi (7-12) — kayıt aşamasında admin girer. LGS mi (7-8) yoksa
  // TYT/AYT mi (9-12) gösterileceğini bu alan belirler (bkz. server/src/subjects.js). Nullable:
  // admin henüz girmemiş eski kayıtlarda geçici olarak boş kalabilir, o durumda YKS'ye düşülür.
  gradeLevel Int?
  // Öğrencinin sabit (1'e-çok) koçu — yalnızca admin atar/değiştirir. Koç tüm derslerde bu
  // öğrenciye ödev verebilir (derse göre yetki kısıtlaması yok).
  teacherId String?
  teacher   User?   @relation("CoachAssignment", fields: [teacherId], references: [id], onDelete: SetNull)
  // Uygulamayı en son kullandığı an — requireAuth her kimlik doğrulamalı istekte (en fazla 10 dakikada
  // bir) günceller. Koç panosundaki "4 gündür giriş yok" ve öğrenci detayındaki "son giriş" buradan;
  // yalnızca koçu (kendi öğrencileri) ve admin görür, branş öğretmeni görmez.
  lastSeenAt DateTime?
  // Koçun bu öğrenci hakkındaki tarihli özel notları (bkz. CoachNote) ve bir koçun yazdığı notlar.
  notesAbout   CoachNote[] @relation("NoteStudent")
  aiAnalyses   AiAnalysis[] @relation("AiAnalysisStudent")
  notesWritten CoachNote[] @relation("NoteAuthor")
  // --- Yalnızca role=TEACHER için anlamlı ters ilişki ---
  students User[] @relation("CoachAssignment")
  // --- Yalnızca role=TEACHER için anlamlı ---
  // Admin tarafından işaretlenir — okulun bir dersini (ör. Matematik, Türkçe) okuyan branş
  // öğretmeni olduğunu belirtir. Bu bayrak true olan öğretmenler PlanEntry/Assignment
  // oluştururken hedefi yalnızca kendi koçluk ettiği öğrencilerle SINIRLI TUTMAYIP, okuldaki
  // ilgili sınav türüne (LGS/YKS) hazırlanan TÜM öğrencilere ortak bir ödev gönderebilir (bkz.
  // routes/planEntries.js > publishPlanEntry, entry.schoolWide). Sıradan bir koç (kişisel mentor)
  // bu yetkiyi asla görmez/kullanamaz — okul çapında yanlışlıkla toplu gönderim riskini admin'in
  // bilinçli onayına bağlar.
  isSubjectTeacher Boolean @default(false)
  // Branş öğretmeninin okuttuğu dersler (ör. ["Türkçe", "Edebiyat"]) — server/src/subjects.js > BRANCHES
  // listesindeki ana ders adları; AYT'deki alt adlar (Tarih-1, Coğrafya-2, Mantık...) branşa
  // branchOfSubject ile bağlanır. Admin bir öğretmene en az bir branş verince isSubjectTeacher de açılır.
  teachingSubjects String[] @default([])

  createdAt DateTime @default(now())

  assignmentsCreated   Assignment[]
  assignmentRecipients AssignmentRecipient[]
  studySessions        StudySession[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  planEntries          PlanEntry[]

  @@index([role])
  @@index([teacherId])
}

// Bir koçun oluşturduğu ödev ŞABLONU — "kime gönderildi/tamamlandı mı" bilgisi AssignmentRecipient
// satırlarında tutulur (aynı içerik birden fazla öğrenciye paylaşılsa da tamamlama durumu bağımsızdır).
model Assignment {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  examType  ExamType
  // Sabit TYT/AYT ders listesinden biri — Prisma enum DEĞİL, server/src/subjects.js içindeki sabit
  // listeye karşı doğrulanan serbest metin (yeni ders eklemek/düzeltmek migration gerektirmesin diye).
  subject String
  // "Müfredat Konusu" — MVP'de serbest metin (tam müfredat ağacını elle kürase etmekten kaçınmak
  // için bilinçli bir basitleştirme).
  topic String
  // "Kaynak Kitap" — serbest metin; istemci GET /api/assignments/source-books ile aynı koçun daha
  // önce kullandığı isimleri otomatik-tamamlama önerisi olarak gösterir.
  sourceBook String?
  // "Sayfa/Soru Aralığı" — tek serbest metin alanı (ör. "45-60" ya da "120 soru").
  pageRange String?
  // Öğrenciye gösterilen serbest açıklama — şimdilik yalnızca Takvim'den yayınlanan kayıtların notu
  // (PlanEntry.note) buraya taşınır; önceden yayınlarken sessizce kayboluyordu.
  note String?

  period        Period // yalnızca sınıflandırma etiketi, otomatik tekrar üretmez
  // Ödevin başlangıç tarihi — takvimde/otomatik gönderim tetiklemesinde (AUTO_ON_DATE/AUTO_DAY_BEFORE)
  // kullanılan tarih budur.
  scheduledDate DateTime
  // Ödevin bitiş/teslim tarihi — koç tek bir gün yerine bir ARALIK vermek isterse (ör. bir haftalık
  // ödev) burası scheduledDate'ten ileri bir tarih olur. Formda başlangıç girilince otomatik olarak
  // aynı gün önerilir, koç isterse değiştirir; bu yüzden scheduledDate'ten KÜÇÜK olamaz ama optional
  // değil — her zaman en az scheduledDate'e eşit bir değer taşır (bkz. routes/assignments.js).
  endDate  DateTime
  sendMode SendMode
  status        AssignmentStatus @default(DRAFT)
  targetMode    AssignmentTarget
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  // endDate geçtiğinde, hâlâ tamamlamamış öğrencisi varsa koça BİR KEZ gönderilen özet bildirimin
  // zamanı — scheduler.js > notifyTeachersOfOverdueAssignments bunu null olan kayıtları arar, işleyip
  // (öğrenci hâlâ eksikse ya da hepsi tamamlamış olsa bile) hemen doldurur, aynı ödev için asla ikinci
  // bir bildirim atılmaz.
  teacherOverdueNotifiedAt DateTime?
  // Branş öğretmeni "Koçlara özet gönder" dediği an — sonuç girmeyen öğrencilerin koçlarına bildirim;
  // aynı ödev için günde bir kez (bkz. routes/branch.js).
  coachReminderSentAt DateTime?

  recipients AssignmentRecipient[]
  planEntry  PlanEntry?

  @@index([teacherId, status])
  @@index([status, sendMode, scheduledDate])
}

enum PlanWeekKind {
  TOPIC          // konu anlatımı — ders/konu bazlı haftalık ödev
  PRACTICE_TEST  // deneme çözümü haftası
  HOLIDAY        // tatil ödevi haftası
}

// Bir hafta elle mi yayınlanacak, yoksa zamanı gelince scheduler.js tarafından mı otomatik
// yayınlanacak — bkz. Assignment.sendMode'daki AUTO_ON_DATE/AUTO_DAY_BEFORE ile aynı fikir, ama
// PlanWeek henüz bir Assignment olmadığı (assignmentId null olduğu) için ayrı bir alan.
enum PlanAutoSend {
  OFF         // koç "Yayınla"ya kendi basana kadar hiçbir şey olmaz (varsayılan)
  ON_DATE     // scheduledDate gelince otomatik yayınlanır
  DAY_BEFORE  // scheduledDate'ten bir gün önce otomatik yayınlanır
}

// Bir koçun bir sınav türü için hazırladığı yıllık ödev TAKVİMİ — gerçek bir takvim günü (date)
// başına BİRDEN FAZLA kayıt olabilir (ör. aynı gün Matematik + Türkçe + Fen ayrı ayrı ödevlenebilir,
// bkz. okul koordinatörünün notu: "bir günde 2-3 dersten soru gönderebilir"). Bu yüzden eski
// PlanWeek'in aksine (haftaId, sınavTürü) üzerinde bir @@unique YOKTUR — aynı (teacherId, examType,
// date) için istenildiği kadar satır oluşturulabilir. Bir satır "yayınlan"dığında gerçek bir
// Assignment'a dönüşür (bkz. routes/planEntries.js > publish) — plan, ödev oluşturmanın YERİNE değil,
// ÖNÜNE geçen bir şablon/takvim katmanıdır.
model PlanEntry {
  id        String       @id @default(cuid())
  teacherId String
  teacher   User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  examType  ExamType
  // Yalnızca takvim günü anlamlı — saat/dakika kısmı yok sayılır (00:00 olarak saklanır).
  date      DateTime
  // Birden çok günü kapsayan kayıtlar için (ör. bir haftalık tatil ödevi) son gün — null ise tek
  // günlük kayıt (bitiş = date). Yayınlanınca Assignment.endDate olur; aksi halde çok günlük bir
  // ödev ertesi gün "gecikti" sayılıp öğrencilere gecikme bildirimi gidiyordu.
  endDate   DateTime?
  kind      PlanWeekKind @default(TOPIC)

  // --- kind=TOPIC için anlamlı ---
  subject       String?
  topic         String?
  sourceBook    String?
  pageRange     String?
  // Günlük ödev başına hedeflenen soru sayısı — okul kuralı: en fazla 30 (bkz. validators, routes/planEntries.js).
  questionCount Int?

  // --- kind=PRACTICE_TEST / HOLIDAY için serbest not (ör. "Her gün 1 deneme çöz") ---
  note String?

  // Yayınlandığında (publish) yalnızca bu kaydı oluşturan öğretmenin kendi öğrencilerine değil,
  // okuldaki (examType'a karşılık gelen track'teki) TÜM öğrencilere gönderilsin mi — yalnızca
  // User.isSubjectTeacher=true olan öğretmenler true olarak ayarlayabilir (bkz. routes/planEntries.js).
  schoolWide Boolean @default(false)

  autoSend     PlanAutoSend @default(OFF)
  assignmentId String?      @unique
  assignment   Assignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([teacherId, examType, date])
}

// Bir ödevin tek bir hedef öğrenciye düşen kopyası — tamamlanma durumu öğrenci başına bağımsız.
model AssignmentRecipient {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Submission oluşturulduğunda birlikte (tek transaction'da) true yapılır — ayrı bir "tamamlandı
  // işaretle" adımı yok, öğrenci doğrudan sonucu girerek tamamlar.
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  // Ödevin süresi (assignment.endDate) geçtiğinde, öğrenci hâlâ tamamlamamışsa BİR KEZ gönderilen
  // hatırlatma bildiriminin zamanı — scheduler.js > notifyOverdueRecipients bunu null olan kayıtları
  // arar, bildirimi atıp hemen doldurur, aynı öğrenciye aynı ödev için asla ikinci kez atılmaz.
  overdueReminderSentAt DateTime?
  // Bitiş günü 18:00'de (Türkiye) "bugün son gün" hatırlatması gönderildiği an — scheduler.js >
  // notifyDueToday; gecikme hatırlatmasından ayrı, her ikisi de alıcı başına en fazla bir kez gider.
  dueReminderSentAt DateTime?
  // Öğrenci ödevi çözemediyse "pas geçer" — boş bırakmaktan farklı: sebebi sorulur (KONU: konuyu
  // bilmiyorum, ZAMAN: zaman yetmedi, KAYNAK: kaynağım yok, DIGER: başka sebep + skipNote). Pas geçilen
  // ödeve gecikme/son gün hatırlatması gitmez; öğrenci sonradan sonucunu girerse pas kaldırılır.
  // Sebebin "sahibi" branş ekranında gösterilir: konu → branş öğretmeni, zaman → koç, kaynak → yönetim.
  skippedAt  DateTime?
  skipReason String?
  skipNote   String?
  // Öğrenci önce pas geçip SONRA sonucunu girdiyse (ya da pası geri alıp girdiyse) o pasın zamanı ve sebebi (skippedAt
  // silinir). Rapor bu teslimi — pas bitiş gününden önce verildiyse — "geç teslim" değil "pastan dönüş" (dürüst pasın
  // düzeltilmesi) sayar. Yalnızca teslim edilmiş kayıtta anlamlıdır.
  priorSkippedAt  DateTime?
  priorSkipReason String?

  submission Submission?
  // Submission'dan bağımsız — öğrenci sonucu girmeden ÖNCE de kanıt fotoğrafı ekleyebilir.
  photos RecipientPhoto[]

  @@unique([assignmentId, studentId])
  @@index([studentId, completed])
}

// Öğrencinin bir ödeve kanıt olarak eklediği fotoğraf. Diskte assignmentPhotosRoot()/<recipientId>/
// altında rastgele (crypto.randomUUID) bir ad ile saklanır — sıralı/tahmin edilebilir olmadığı için
// dosyalar requireAuth olmadan /uploads altından servis edilir (bkz. app.js).
model RecipientPhoto {
  id          String              @id @default(cuid())
  recipientId String
  recipient   AssignmentRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  createdAt   DateTime            @default(now())

  @@index([recipientId])
}

// Öğrencinin bir AssignmentRecipient için girdiği sonuç — 1'e-1.
model Submission {
  id           String              @id @default(cuid())
  recipientId  String              @unique
  recipient    AssignmentRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  correctCount Int // Doğru
  wrongCount   Int // Yanlış
  blankCount   Int // Boş
  note         String?
  // Yanlış/boş yapılan soru numaraları — isteğe bağlı.
  questionNumbers Int[]    @default([])
  createdAt       DateTime @default(now())
}

// Öğrencinin herhangi bir atanmış ödeve bağlı OLMAYAN, kendi başlattığı serbest çalışma kaydı —
// Assignment+Submission'ın alan şekliyle birebir aynı, ama DRAFT/SENT yaşam döngüsü yok; oluşturulduğu
// an zaten kayda geçmiş sayılır (koç onayı gerekmez).
model StudySession {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examType   ExamType
  subject    String
  topic      String
  sourceBook String?
  pageRange  String?

  correctCount Int
  wrongCount   Int
  blankCount   Int
  note         String?

  questionNumbers Int[] @default([])
  // Öğrencinin "ne zaman çalıştım" dediği tarih — kayıt anından (createdAt) ayrı, dünkü çalışmasını
  // bugün girebilir.
  studyDate DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([studentId, studyDate])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text   String
  type   String  @default("info")
  read   Boolean @default(false)
  // Bildirime dokununca nereye gidileceği (ör. {"recipientId":"...","screen":"assignmentSubmit"}).
  data      Json?
  // Sessiz saatlerde (23:00-07:00) oluşan bildirim uygulamada hemen görünür ama telefona push'u
  // bekletilir — sabah ilk scheduler tick'inde kullanıcı başına tek push olarak gider (notify.js >
  // flushPendingPushes).
  pushPending Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([pushPending])
}

// Bir kullanıcının bir cihazdaki FCM kayıt token'ı — upsert edilir. Bu proje kendi Firebase
// projesine bağlanır, başka bir projeyle paylaşılmaz.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// Okul çapında TEK satır (id her zaman "singleton") — admin panelinden ayarlanır. Şu an yalnızca
// YKS/LGS sınav tarihlerini tutuyor; öğrenci ana ekranındaki "sınava kaç gün kaldı" sayacı bunu
// okur. Tarihler resmi ÖSYM/MEB takvimi açıklanınca admin tarafından güncellenir, koda gömülü değil.
model SchoolSettings {
  id          String    @id @default("singleton")
  yksExamDate DateTime?
  lgsExamDate DateTime?
  // Yapay zekâ incelemesi (aylık raporda koça öneriler) — varsayılan KAPALI: anonimleştirilmiş sonuç
  // özetleri yurt dışındaki bir hizmete (Anthropic) gider; okul KVKK açısından onaylayınca admin açar.
  aiEnabled   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
}

// Koçun bir öğrenci hakkında tuttuğu tarihli özel not — YALNIZCA yazan koç görür (öğrenciye, branş
// öğretmenine, başka koça hiçbir zaman gösterilmez). Öğrenci başka koça geçerse eski koçun notları silinir
// (routes/admin.js > reassign-teacher) — kimsenin göremediği veri tutulmaz. Eskiden öğrenci başına tek bir metin alanıydı (User.coachNote) — migration
// 20260926220000 onu o anki koçun ilk notu olarak taşıdı.
model CoachNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("NoteAuthor", fields: [teacherId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, teacherId, createdAt])
}

// Aylık rapor bildirimi — her ay (YYYY-MM, raporu hazırlanan ay) için bir kez, ayın ilk haftasında saat
// 08:00'den sonraki ilk zamanlayıcı turunda koçlara gider (bkz. scheduler.js > notifyMonthlyReports).
// Satırın varlığı "bu ayın bildirimi gönderildi" demek — birden çok sunucu kopyası olsa da tek gönderim.
model MonthlyReportRun {
  month  String   @id
  // Gönderimi üstlenen turun başladığı an (15 dakikadır bitmediyse başka tur devralır).
  sentAt DateTime @default(now())
  // Tüm koçlara gönderim bitti — null ise yarıda kalmış olabilir (koç başına tekrar gönderim engelli).
  completedAt DateTime?
}

// Aylık raporun yapay zekâ incelemesi (öğrenci × ay) — yalnızca öğrencinin koçu ve admin görür. Üretim
// ücretli olduğu için saklanır; aynı ay için yeniden üretim sınırlı (bkz. routes/aiAnalysis.js).
model AiAnalysis {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("AiAnalysisStudent", fields: [studentId], references: [id], onDelete: Cascade)
  month     String
  content   Json
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, month])
}
