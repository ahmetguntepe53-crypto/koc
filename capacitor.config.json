{
  "appId": "com.kocluk.app",
  "appName": "Kocluk",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F5F6FB",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#FFFFFFFF",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}